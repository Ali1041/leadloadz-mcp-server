{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Ali1041/leadloadz",
  "description": "B2B lead search and email verification MCP server",
  "repository": {
    "url": "https://github.com/Ali1041/leadloadz-mcp-server",
    "source": "github"
  },
  "version": "1.1.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@leadloadz/mcp-server",
      "version": "1.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your Leadloadz API key",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "LEADLOADZ_API_KEY"
        },
        {
          "description": "API base URL (default: https://leadloadz.com/api/mcp). Do not use www — redirects strip auth headers.",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "LEADLOADZ_API_BASE"
        }
      ]
    }
  ]
}
