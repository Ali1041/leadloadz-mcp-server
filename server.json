{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ali1041/leadloadz",
  "description": "MCP server for Leadloadz B2B lead search and email verification. Connects AI assistants to 5M+ verified B2B contacts with real-time email verification.",
  "repository": {
    "url": "https://github.com/Ali1041/leadloadz-mcp-server",
    "source": "github"
  },
  "version": "1.0.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@leadloadz/mcp-server",
      "version": "1.0.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your Leadloadz API key from https://www.leadloadz.com/dashboard/api-tokens",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "LEADLOADZ_API_KEY"
        }
      ]
    }
  ]
}
